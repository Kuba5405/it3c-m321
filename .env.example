# Beispielwerte für den Unterricht. Die echte .env steht in .gitignore.
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=bitte-lokal-aendern

# Datenbank. Der Postgres-Container legt Benutzer und Datenbank beim
# ersten Start mit diesen Werten an.
POSTGRES_USER=chat
POSTGRES_PASSWORD=bitte-lokal-aendern
POSTGRES_DB=chat

# batch-writer (Vorgabewerte, nur ändern, wer es messen will)
# Ein Stapel ist fertig bei dieser Anzahl Nachrichten ...
BATCH_SIZE=500
# ... oder nach so vielen Millisekunden. Was zuerst eintritt.
BATCH_TIMEOUT_MS=200
# Pause nach einem Datenbankfehler, bevor der Stapel zurück in die Queue geht.
RETRY_DELAY_MS=2000
